@page
@model GameLocadora.Pages.JogosModel
@{
    ViewData["Title"] = "Cadastro de Jogos";

    
}
<h2>Novo jogo</h2>
<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Plataforma" class="form-label"></label>
        <input asp-for="Plataforma" class="form-control" />
        <span asp-validation-for="Plataforma" class="text-danger"></span>
    </div>
    <div class="mb-3">
           <label asp-for="Genero" class="form-label"></label>
        <input asp-for="Genero" class="form-control" />
        <span asp-validation-for="Genero" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ValorDiaria" class="form-label"></label>
        <input asp-for="ValorDiaria" class="form-control" type="number" step=0.01 min="0.01" max="1000" />
        <span asp-validation-for="ValorDiaria" class="text-danger"></span>
    </div>
    <label asp-for="Capa" class="form-label"></label>
    <input asp-for="Capa" class="form-control" type="file"
        accept=".jpg, .jpeg, .png" />
    <img id="PreviaCapa" class="img-thumbnail mt-2 d-none" style="max-heigth: 160px" alt="pré visualização" />

    <button type="submit" class="btn btn-primary">Salvar</button>
</form>
<hr />

<table class="table table-stripped"  id="tabela">
    <thead>
        <tr>
            <th>Capa</th>
            <th>Título</th>
            <th>Plataforma</th>
            <th>Genero</th>
            <th>Valor diária</th>
             <th>Situação</th>
             <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListaJogos)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.CapaArquivo))
                    {
                        <img src="~/capas/@item.CapaArquivo" width=50 height=50 alt="capa de @item.Titulo" />
                    }
                    else
                    {
                        <span class="text-muted">Sem capa</span>
                    }
                </td>
                <td>@item.Titulo</td>
                <td>@item.Plataforma</td>
                <td>@item.Genero</td>
                <td>@item.ValorDiariaCentavos</td>
                <td>@(item.Ativo ? "Ativo" : "Inativo")</td>
                <td><a asp-page="/EditarJogo" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a> </td>

            </tr>
        }
    </tbody>
</table>

@section Scripts{
    <script>
        const mensagem = "@TempData["Mensagem"]";
    </script>
    <script>
        //dispara a mensagem de sucesso.
        if (mensagem != ""){
            Swal.fire({
                title: "Mensagem",
                text: mensagem,
                icon: "success"
            });
        }
        //inicia a tabela com o datatable
        $("#tabela").DataTable();

        $("#Capa").on("change", function  () {
            const arquivo = this.files[0];
            const preview = $("#PreviaCapa");
            if(arquivo && arquivo.type.startsWith("image/")){
                preview.attr("src", URL.createObjectURL(arquivo)).removeClass("d-none");
            }
            else {
                preview.addClass("d-none").removeAttr("src");
            }
        })

       


    </script>
}
